[Unit]
Description=SCION API Server
After=network.target
Requires=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/scion-api-server
Restart=on-failure
RestartSec=5s
RemainAfterExit=yes  # Track "active" state after exit
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target